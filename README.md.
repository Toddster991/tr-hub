      }catch(err){ $('tplMsg').textContent = "Couldn't save the steps. Try again."; }
    }
  });

  // ---------- materials tab ----------
  // ---------- people ----------
  const people = () => Array.isArray(S.people) ? S.people : [];
  const personName = id => { const p = people().find(x=>x.id===id); return p ? p.name : ''; };
  // who owns an item on a job: the job's own choice, else the company default; "@super" means the job's supervisor
  function ownerOf(j, x){
    const m = (j.materials && j.materials[x.name]) || {};
    const c = catalog().find(c=>c.name===x.name) || {};
    const v = m.owner || c.owner || '';
    if(v==='@super'){ const sn = superKey(j); const p = people().find(p=>p.name.toLowerCase()===sn.toLowerCase()); return p ? {key:p.id, name:p.name} : sn ? {key:'n:'+sn.toLowerCase(), name:sn} : {key:'', name:''}; }
    const n = personName(v);
    return n ? {key:v, name:n} : {key:'', name:''};
  }
  function ownerOptions(){
    const list = people().map(p=>({key:p.id, name:p.name}));
    S.jobs.forEach(j=>{ const sn = superKey(j); if(sn && !list.some(o=>o.name.toLowerCase()===sn.toLowerCase())) list.push({key:'n:'+sn.toLowerCase(), name:sn}); });
    return list.sort((a,b)=>a.name.localeCompare(b.name));
  }

  // ---------- materials tab ----------
  const STATUS_RANK = {none:0, selected:1, ordered:2, delivered:3, skip:4};
  function sortMat(list){
    const k = S.msort, dir = S.mdir || 1, big = 1e9;
    const val = r => k==='order' ? (r.x.orderBy ?? big) : k==='need' ? (r.x.need ?? big) : k==='status' ? STATUS_RANK[r.x.status] : k==='lead' ? (r.x.lead ?? big)
      : k==='job' ? String(r.j.name||'').toLowerCase() : k==='item' ? r.x.name.toLowerCase() : (r.o.name||'~').toLowerCase();
    return list.slice().sort((a,b)=>{ const va = val(a), vb = val(b);
      const c = va<vb ? -1 : va>vb ? 1 : 0;
      return c ? c*dir : ((a.x.orderBy??big) - (b.x.orderBy??big)) || String(a.j.name).localeCompare(String(b.j.name)); });
  }
  function renderMaterials(home=false){
    const tw = $('tableWrap'); tw.classList.remove('tall');
    const opts = ownerOptions();
    // the home page is the materials list fixed to one person, by urgency, without the owner column
    const keep = {owner:S.owner, matView:S.matView};
    if(home){ S.owner = S.me; S.matView = 'urgency'; }
    try{ renderMaterialsInner(opts, home); } finally { if(home){ S.owner = keep.owner; S.matView = keep.matView; } }
  }
  function renderMaterialsInner(opts, home){
    const tw = $('tableWrap');
    if(!home && S.owner && S.owner!=='all' && S.owner!=='none' && !opts.some(o=>o.key===S.owner)) S.owner = 'all';
    if(!home) $('ownerPick').innerHTML = `<option value="all">Everyone</option>` + opts.map(o=>`<option value="${esc(o.key)}"${o.key===S.owner?' selected':''}>${esc(o.name)}</option>`).join('') + `<option value="none"${S.owner==='none'?' selected':''}>Unassigned</option>`;
    if(!home) $('ownerPick').value = S.owner || 'all';
    const jobs = S.jobs.filter(j=>!isOff(j) && (S.showDesign || j.status!=='design'));
    const noType = jobs.filter(j=>!ctypeOf(j));
    const today = dayNum(new Date()), fri = P.week.idx(new Date());
    let rows = []; jobs.forEach(j=>materialsFor(j).forEach(x=>{ if(x.status!=='skip') rows.push({j, x, o:ownerOf(j,x)}); }));
    if(S.owner==='none') rows = rows.filter(r=>!r.o.key);
    else if(S.owner && S.owner!=='all') rows = rows.filter(r=>r.o.key===S.owner);
    const open = rows.filter(r=>(r.x.status==='none'||r.x.status==='selected') && r.x.orderBy!=null).sort((a,b)=>a.x.orderBy-b.x.orderBy);
    const onOrder = rows.filter(r=>r.x.status==='ordered').sort((a,b)=>(a.x.need??0)-(b.x.need??0));
    const who = home ? '' : S.owner==='all' || !S.owner ? '' : S.owner==='none' ? 'Unassigned: ' : `${esc((opts.find(o=>o.key===S.owner)||{}).name||'')}: `;
    let t = '';
    if(!rows.length) t = noType.length && S.owner==='all' ? 'Give your jobs a construction type to see what needs ordering and when.' : `${who}nothing to track right now.`;
    else {
      const late = open.filter(r=>r.x.orderBy < today).length, wk = open.filter(r=>r.x.orderBy >= today && r.x.orderBy <= fri).length, nx = open.filter(r=>r.x.orderBy > fri && r.x.orderBy <= fri+28).length;
      const parts = [];
      if(late) parts.push(`<b>${late}</b> past their order-by date`);
      parts.push(`<b>${wk}</b> to order this week`);
      parts.push(`${nx} in the next 4 weeks`);
      if(onOrder.length) parts.push(`${onOrder.length} on order`);
      t = who + parts.join(', ') + '.';
      const decide = open.filter(r=>r.x.flags.includes('Selections finish too late')).length;
      if(decide) t += ` ${decide} item${decide===1?' is':'s are'} scheduled to be selected after they need to be ordered.`;
    }
