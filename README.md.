      if(STATUS[v.status] && v.status!=='none') c.status = v.status;
      if(parseFloat(v.lead)>0) c.lead = parseFloat(v.lead);
      if(parseDate(v.ordered)) c.ordered = v.ordered; if(parseDate(v.promised)) c.promised = v.promised;
