    }catch(err){
      showErr(err && err.code==='invalid_argument' ? "You don't have permission to change jobs on this page." : err && err.code==='quota_exceeded' ? 'Storage for this page is full. Delete old jobs to make room.' : "Couldn't save the job. Try again.");
    }finally{ F('save').disabled = false; }
  }
