    if(!sd.jobs.length){ $('summary').textContent = S.storage==='loading' ? '' : 'Jobs in design need a production start and duration to appear here; active jobs need months remaining.'; tw.hidden = true; return; }
    $('summary').innerHTML = busy.length ? 'Right now: ' + busy.map(x=>`<b>${esc(x.d)}</b> on ${x.n} job${x.n===1?'':'s'}`).join(', ') + '.' : 'No scheduled work falls on today.';
    if(!sd.periods.length){ tw.hidden = true; return; }
    tw.hidden = false;
    if(board){ renderBoard(sd); return; }
    const nowc = k => k===sd.now ? ' now' : '';
    let h = `<thead><tr><th>${S.sview==='job'?'Job and steps':'Department and jobs'}</th>${sd.periods.map(k=>`<th class="${nowc(k)}" title="${esc(p.long(k))}">${esc(p.head(k))}</th>`).join('')}<th class="tot">Dates</th></tr></thead><tbody>`;
    if(S.sview==='job'){
      sd.jobs.sort((a,b)=>a.plan[0].s-b.plan[0].s).forEach(({j,plan})=>{
        const sup = superKey(j);
        h += `<tr class="sub jobhead"><td title="${esc(j.name||'')}"><span class="mk ${j.status==='design'?'dsg':'a'}"></span>${esc(j.name||'Untitled job')}${sup?` <span class="cnt">${esc(sup)}</span>`:''}</td>${sd.periods.map(k=>`<td class="${nowc(k)}"></td>`).join('')}<td class="tot dates">${rangeTxt(plan[0].s, plan[plan.length-1].e)}</td></tr>`;
        plan.forEach((r,i)=>{
