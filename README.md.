  async function syncMembers(list){
    // make the sign-in list match the People panel; never removes or demotes the person saving
    const me = (S.myEmail||'').toLowerCase();
    const want = new Map();
    list.forEach(p=>{ const e = (p.email||'').toLowerCase(); if(e && p.access) want.set(e, {email:e, name:p.name, role:p.access}); });
    if(me){ const cur = want.get(me); want.set(me, {email:me, name:(cur&&cur.name)||'', role:'admin'}); }
    const have = new Map((S.members||[]).map(m=>[(m.email||'').toLowerCase(), m]));
    const up = [...want.values()].filter(w=>{ const h = have.get(w.email); return !h || h.role!==w.role || (w.name && h.name!==w.name); });
    const del = [...have.keys()].filter(e=>!want.has(e));
    if(up.length){ const r = await S.sb.from('fc_members').upsert(up); if(r.error) throw r.error; }
    for(const e of del){ const r = await S.sb.from('fc_members').delete().eq('email', have.get(e).email); if(r.error) throw r.error; }
    await loadMembers();
  }
