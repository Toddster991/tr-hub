  // ---------- storage: Supabase ----------
  const SUPABASE_URL = 'https://enukninnuqctyywsfqkz.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_BPNuq70bfpn0nXrsB5Ik3g_TngUoJtU';

  // A small adapter so the app keeps using the same calls it always has (collection/doc, set/update/delete, onSnapshot)
  function makeDb(sb){
    const jobs = new Map(), settings = new Map(), jobSubs = [], setSubs = {};
    const jobDocs = () => [...jobs.entries()].map(([id,data])=>({id, exists:true, data:()=>data}));
    const emitJobs = () => jobSubs.forEach(f=>f({docs:jobDocs()}));
    const emitSet = id => { const v = settings.get(id); (setSubs[id]||[]).forEach(f=>f({exists:v!=null, data:()=>v})); };
    const fail = e => { const err = new Error(e && e.message || 'Request failed'); err.code = (e && /row-level security|permission|only admins/i.test(e.message||'')) ? 'invalid_argument' : 'failed'; return err; };
    async function loadAll(){
      const [a,b] = await Promise.all([ sb.from('fc_jobs').select('id,data'), sb.from('fc_settings').select('id,data') ]);
      if(a.error) throw fail(a.error); if(b.error) throw fail(b.error);
      jobs.clear(); a.data.forEach(r=>jobs.set(r.id, r.data));
      settings.clear(); b.data.forEach(r=>settings.set(r.id, r.data));
    }
    const ready = loadAll();
    sb.channel('fc-live')
      .on('postgres_changes', {event:'*', schema:'public', table:'fc_jobs'}, p=>{ if(p.eventType==='DELETE') jobs.delete(p.old.id); else jobs.set(p.new.id, p.new.data); emitJobs(); })
      .on('postgres_changes', {event:'*', schema:'public', table:'fc_settings'}, p=>{ const id = p.eventType==='DELETE' ? p.old.id : p.new.id; if(p.eventType==='DELETE') settings.delete(id); else settings.set(id, p.new.data); emitSet(id); })
      .subscribe();
    // catch anything missed while the tab was in the background
    document.addEventListener('visibilitychange', ()=>{ if(document.visibilityState==='visible') loadAll().then(()=>{ emitJobs(); Object.keys(setSubs).forEach(emitSet); }).catch(()=>{}); });
    const clean = o => JSON.parse(JSON.stringify(o));
    const settingsDoc = id => ({
      onSnapshot(cb, err){ (setSubs[id] = setSubs[id] || []).push(cb); ready.then(()=>cb({exists:settings.has(id), data:()=>settings.get(id)})).catch(e=>err && err(e)); },
      async set(data){ const d = clean(data); const r = await sb.from('fc_settings').upsert({id, data:d}); if(r.error) throw fail(r.error); settings.set(id, d); emitSet(id); },
    });
    return {
      doc(path){ return settingsDoc(path.split('/')[1]); },
      collection(){ return {
        onSnapshot(cb, err){ jobSubs.push(cb); ready.then(()=>cb({docs:jobDocs()})).catch(e=>err && err(e)); },
        doc(id){ return {
          async set(data){ const d = clean(data);
            const r = jobs.has(id) ? await sb.from('fc_jobs').update({data:d}).eq('id', id).select('id') : await sb.from('fc_jobs').insert({id, data:d}).select('id');
            if(r.error) throw fail(r.error); if(!r.data || !r.data.length) throw fail({message:'permission'}); jobs.set(id, d); emitJobs(); },
          async update(fields){ const d = clean({...(jobs.get(id)||{}), ...fields});
            const r = await sb.from('fc_jobs').update({data:d}).eq('id', id).select('id');
            if(r.error) throw fail(r.error); if(!r.data || !r.data.length) throw fail({message:'permission'}); jobs.set(id, d); emitJobs(); },
          async delete(){ const r = await sb.from('fc_jobs').delete().eq('id', id); if(r.error) throw fail(r.error); jobs.delete(id); emitJobs(); },
        }; },
      }; },
    };
  }

  function startData(db, email){
    S.db = db; S.myEmail = email;
    db.doc('settings/people').onSnapshot(d=>{
      const v = d.exists ? d.data() : null;
      S.people = v && Array.isArray(v.people) ? v.people : null;
      // open straight to the signed-in person's list
      const me = people().find(p=>(p.email||'').toLowerCase()===email.toLowerCase());
      if(me && S.me!==me.id){ S.me = me.id; try{ localStorage.setItem('fc_me', me.id); }catch(e){} }
      if(!S.peopleDirty){ S.peopleDraft = null; renderPeopleEditor(); }
      renderCtEditor(); render(); renderEditorExtras();
    }, ()=>{});
    db.doc('settings/construction').onSnapshot(d=>{
      const v = d.exists ? d.data() : null;
      S.ctypes = v && Array.isArray(v.ctypes) ? v.ctypes : null;
      S.catalog = v && Array.isArray(v.catalog) ? v.catalog : null;
      S.bufferW = v && isFinite(parseFloat(v.bufferWeeks)) ? parseFloat(v.bufferWeeks) : null;
      if(!S.ctDirty){ S.ctDraft = null; renderCtEditor(); }
      render(); renderEditorExtras();
    }, ()=>{});
    db.doc('settings/schedule').onSnapshot(d=>{
      const st = d.exists && d.data() && Array.isArray(d.data().steps) ? d.data().steps : null;
      S.template = st; if(!S.tplDirty) renderTplEditor(); render();
    }, ()=>{});
    db.collection('jobs').onSnapshot(snap=>{
      S.jobs = snap.docs.filter(d=>d.exists).map(d=>({id:d.id, ...d.data()}));
      S.storage = 'db';
      if(S.sel && S.sel!=='new' && !S.jobs.find(j=>j.id===S.sel)) { S.sel=null; $('editor').hidden=true; document.body.classList.remove('editing'); }
      render();
    }, ()=>{ S.db = null; S.storage = 'memory'; render(); });
  }

  // ---------- sign-in ----------
  (async()=>{
    const showAuth = step => { $('auth').hidden = false; ['authStep1','authStep2','authDenied'].forEach(id=>$(id).hidden = id!==step); $('authErr').hidden = true; };
    const authErr = m => { $('authErr').textContent = m; $('authErr').hidden = false; };
    if(!window.supabase || SUPABASE_KEY.startsWith('PASTE')){ S.storage = 'memory'; render(); showAuth('authStep1'); authErr('This copy of the app isn’t connected to the database yet.'); return; }
    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth:{ persistSession:true, autoRefreshToken:true, detectSessionInUrl:true } });
    let started = false, checking = false;
    async function onSession(session){
      if(!session){ showAuth('authStep1'); $('signOut').hidden = true; $('whoami').textContent = ''; return; }
      if(started || checking) return; checking = true;
      const email = session.user.email || '';
      // members only: the member list is readable only by people on it
      const m = await sb.from('fc_members').select('email,role').ilike('email', email).limit(1);
      checking = false;
      if(m.error || !m.data || !m.data.length){ $('authDeniedEmail').textContent = email; showAuth('authDenied'); return; }
      S.role = m.data[0].role === 'admin' ? 'admin' : 'ordering'; S.sb = sb;
      document.body.classList.toggle('ro', S.role!=='admin');
      $('auth').hidden = true; $('signOut').hidden = false; $('whoami').textContent = `${email} (${S.role==='admin'?'Admin':'Ordering'})`;
      if(S.role==='admin') loadMembers();
      started = true; startData(makeDb(sb), email);
    }
    $('authSend').addEventListener('click', async ()=>{
      const email = $('authEmail').value.trim();
      if(!/^\S+@\S+\.\S+$/.test(email)) return authErr('Enter a valid email address.');
      $('authSend').disabled = true;
      const redirect = /^https?:/.test(location.protocol) ? location.href.split('#')[0] : undefined;
      const r = await sb.auth.signInWithOtp({ email, options:{ shouldCreateUser:true, emailRedirectTo: redirect } });
      $('authSend').disabled = false;
      if(r.error) return authErr(/rate|seconds/i.test(r.error.message) ? 'Too many tries. Wait a minute and try again.' : 'Couldn’t send the code. Check the email address and try again.');
      showAuth('authStep2'); $('authCode').focus();
    });
    $('authEmail').addEventListener('keydown', e=>{ if(e.key==='Enter') $('authSend').click(); });
    $('authVerify').addEventListener('click', async ()=>{
      const email = $('authEmail').value.trim(), token = $('authCode').value.replace(/\s/g,'');
      if(!token) return authErr('Enter the code from the email.');
      $('authVerify').disabled = true;
      const r = await sb.auth.verifyOtp({ email, token, type:'email' });
      $('authVerify').disabled = false;
      if(r.error) return authErr('That code didn’t work. Check it, or send a new one.');
    });
    $('authCode').addEventListener('keydown', e=>{ if(e.key==='Enter') $('authVerify').click(); });
    $('authBack').addEventListener('click', ()=>showAuth('authStep1'));
    const out = async ()=>{ await sb.auth.signOut(); try{ localStorage.removeItem('fc_me'); }catch(e){} location.reload(); };
    $('signOut').addEventListener('click', out); $('authDeniedOut').addEventListener('click', out);
    sb.auth.onAuthStateChange((evt, session)=>{ setTimeout(()=>onSession(session), 0); });
  })();
})();
