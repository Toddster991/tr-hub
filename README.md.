          return on.length ? `<td class="heat${nowc(k)}" title="${esc(p.long(k)+': '+on.map(x=>x.j.name).join(', '))}">${on.length}</td>` : `<td class="${nowc(k)}"><span class="zero">–</span></td>`;
        }).join('');
        h += `<td class="tot"></td></tr>`;
        rows.forEach(({j,parts},i)=>{
          const first = parts[0].s, last = Math.max(...parts.map(r=>r.e));
          h += `<tr${i===rows.length-1?' class="grp-end"':''}><td class="job" title="${esc(j.name||'')}"><span class="mk ${j.status==='design'?'dsg':'a'}"></span>${esc(j.name||'Untitled job')}</td>`;
          h += sd.periods.map(k=>{
            const hit = parts.filter(r=>overlaps(r,k));
            if(!hit.length) return `<td class="b${nowc(k)}"></td>`;
            const tip = esc(p.long(k)+': '+hit.map(r=>r.name).join(', '));
            if(!single) return `<td class="b${nowc(k)}" title="${tip}"><span class="bar ${lv[k]}"></span></td>`;
            const f = hit.map(stepShade);
            const bg = f.length===1 ? f[0] : `linear-gradient(180deg,${f.map((c,i)=>`${c} ${i/f.length*100}%,${c} ${(i+1)/f.length*100}%`).join(',')})`;
            return `<td class="b${nowc(k)}" title="${tip}"><span class="bar tall" style="background:${bg}"></span></td>`;
          }).join('');
          h += `<td class="tot dates">${rangeTxt(first,last)}</td></tr>`;
