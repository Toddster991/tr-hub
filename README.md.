    else if(d.step==='Construction'){ fields = {start:upd.start}; undo = {start:d.orig.start}; }
    else { fields = {stepDates:upd.stepDates}; undo = {stepDates:d.orig.stepDates||{}}; }
    applyJobFields(d.id, fields);
    showToast(`${esc(d.orig.name||'Job')}: ${esc(dragTipText({...d, preview:upd}))}.`, ()=>applyJobFields(d.id, undo));
  }
