  const accessOf = p => p.access!==undefined ? p.access : ((S.members||[]).find(m=>(m.email||'').toLowerCase()===(p.email||'').toLowerCase() && p.email)||{}).role || '';
  async function loadMembers(){
    if(!S.sb) return;
