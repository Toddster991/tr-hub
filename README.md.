<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>TR Design Build: Forecast, schedule & materials</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#ECEEEC; --paper:#F8F9F8; --ink:#1E272D; --muted:#5B666D; --rule:#C9CFCF;
  --active:#3D5A73; --design:#D9A816; --field:#FFFFFF; --now:#E2E8EC; --err:#B3261E;
  --load1:#8DBBE3; --load2:#E08A1E; --load3:#C8362F;
  --sans:"Barlow","Segoe UI",system-ui,-apple-system,sans-serif;
  --cond:"Barlow Condensed","Arial Narrow","Segoe UI",system-ui,sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#151A1D; --paper:#1D2428; --ink:#E6EAEB; --muted:#9AA5AB; --rule:#34403F;
    --active:#86A9C7; --design:#E6BC3A; --field:#232B30; --now:#26323A; --err:#F2B8B5;
    --load1:#6F9CCB; --load2:#EFA24A; --load3:#E5605A;
  }
}
:root[data-theme="dark"]{
  --bg:#151A1D; --paper:#1D2428; --ink:#E6EAEB; --muted:#9AA5AB; --rule:#34403F;
  --active:#86A9C7; --design:#E6BC3A; --field:#232B30; --now:#26323A; --err:#F2B8B5;
  --load1:#6F9CCB; --load2:#EFA24A; --load3:#E5605A;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.45}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--active);outline-offset:2px}
.topbar{display:flex;align-items:baseline;gap:14px;padding:18px 28px;border-bottom:1px solid var(--rule)}
.topbar strong{font-family:var(--cond);font-size:22px}
.topbar span{color:var(--muted);font-size:14px}
.topbar .status{margin-left:auto;font-size:13px}
.wrap{display:grid;grid-template-columns:320px minmax(0,1fr);max-width:1440px;margin:0 auto}
aside{padding:22px 24px;border-right:1px solid var(--rule)}
main{padding:24px 32px 56px;min-width:0}
h2{font-family:var(--cond);font-weight:700;font-size:24px;margin:0 0 12px}
.addbtn{width:100%;padding:9px;border:1px dashed var(--muted);border-radius:6px;background:transparent;cursor:pointer;font-weight:500;margin-bottom:18px}
.addbtn:hover{border-style:solid}
.group-h{font-size:14px;font-weight:600;color:var(--muted);margin:14px 0 6px;display:flex;justify-content:space-between}
.joblist{list-style:none;margin:0;padding:0}
.joblist button{display:block;width:100%;text-align:left;background:transparent;border:0;border-left:3px solid transparent;padding:7px 10px;cursor:pointer;border-radius:0 4px 4px 0}
.joblist button:hover{background:var(--paper)}
.joblist button[aria-current="true"]{background:var(--paper);border-left-color:var(--ink)}
.joblist .jn{display:block;font-weight:500}
.joblist .jm{display:block;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}
.empty{color:var(--muted);font-size:14px;margin:6px 0}
.editor{margin-top:22px;padding-top:18px;border-top:1px solid var(--ink)}
label{display:block;font-size:14px;font-weight:500;color:var(--muted);margin:0 0 5px}
.field{margin-bottom:14px}
input,select{width:100%;font:500 16px var(--sans);color:var(--ink);background:var(--field);border:1px solid var(--rule);border-radius:4px;padding:8px 10px}
.row2{display:grid;grid-template-columns:1fr 110px;gap:8px}
.seg{display:flex;border:1px solid var(--rule);border-radius:6px;overflow:hidden}
.seg button{flex:1;font-weight:500;font-size:15px;padding:8px 10px;border:0;background:transparent;color:var(--muted);cursor:pointer;white-space:nowrap}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.preview{font-size:14px;margin:4px 0 14px;font-variant-numeric:tabular-nums}
.actions{display:flex;gap:8px}
.primary{flex:1;padding:9px 12px;border:0;border-radius:6px;background:var(--ink);color:var(--bg);font-weight:600;cursor:pointer}
.ghost{padding:9px 12px;border:1px solid var(--rule);border-radius:6px;background:transparent;cursor:pointer}
.ghost.danger{color:var(--err);border-color:var(--err)}
.calc{margin:6px 0 16px;padding:10px 12px;background:var(--paper);border:1px solid var(--rule);border-radius:6px}
.calc-h{font-size:13px;font-weight:600;color:var(--muted);margin:0 0 4px}
.calc-row{display:flex;justify-content:space-between;gap:12px;padding:3px 0;font-variant-numeric:tabular-nums}
.calc-row span:first-child{color:var(--muted)}
.calc-row b{font-weight:600}
.calc-sub{font-size:13px;color:var(--muted);text-align:right}
.sw{position:relative;display:inline-block;flex:none;width:30px;height:18px;border-radius:9px;border:0;padding:0;margin:0 8px 0 0;vertical-align:-4px;background:var(--rule);cursor:pointer}
.sw::after{content:"";position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--paper);transition:left .15s}
.sw[aria-checked="true"]{background:var(--design)}
.sw[aria-checked="true"]::after{left:14px}
@media (prefers-reduced-motion: reduce){.sw::after{transition:none}}
tr.off td{color:var(--muted)}
.tabs{display:inline-flex;margin-bottom:18px}
.cnt{font-weight:400;color:var(--muted);font-size:13px;margin-left:4px}
td.heat{text-align:center;font-weight:600}
td.b{padding-left:0;padding-right:0;min-width:28px}
.bar{display:block;height:12px;background:var(--active)}
.bar.lv1{background:var(--load1)} .bar.lv2{background:var(--load2)} .bar.lv3{background:var(--load3)}
.mk.dsg{background:var(--design)}
tr.grp-end td{border-bottom:2px solid var(--ink)}
.mk.lv1{background:var(--load1)} .mk.lv2{background:var(--load2)} .mk.lv3{background:var(--load3)}
.mk.stripe{background:var(--muted);background-image:repeating-linear-gradient(135deg,rgba(255,255,255,.55) 0 2px,transparent 2px 5px)}
.refbox{display:inline-flex;align-items:center;gap:8px;margin:0;font-size:14px;color:var(--muted);font-weight:500}
.refbox input{width:130px;padding:5px 8px;font-size:15px}
.refbox select{width:auto;padding:6px 8px;font-size:15px}
td.job .mk{margin-right:6px}
.dp0{background:#5E8C6A} .dp1{background:#8A6BB0} .dp2{background:#B8664A} .dp3{background:#3F8FA8} .dp4{background:#3D5A73} .dp5{background:#A3894A}
.bar.dp0{background:#5E8C6A} .bar.dp1{background:#8A6BB0} .bar.dp2{background:#B8664A} .bar.dp3{background:#3F8FA8} .bar.dp4{background:#3D5A73} .bar.dp5{background:#A3894A}
#legDept{display:inline-flex;gap:16px;flex-wrap:wrap}
tr.jobhead td{font-weight:600}
td.dates{color:var(--muted);font-size:13px}
.tpl{margin-top:22px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.tpl summary{cursor:pointer;padding:12px 14px;font-weight:600}
.tpl .inner{padding:0 14px 14px;overflow-x:auto}
.tpl table{min-width:640px}
.tpl td{text-align:left;padding:4px 6px;border-bottom:0}
.tpl td:first-child{position:static;border-right:0;max-width:none}
.tpl th{text-align:left;padding:4px 6px}
.tpl th:first-child{position:static;border-right:0}
.tpl input,.tpl select{padding:5px 7px;font-size:15px}
.tpl input[type=number]{width:70px}
.tpl input[type=checkbox]{width:auto}
.tpl .rm{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:18px;line-height:1;padding:4px 8px}
.tpl .rm:hover{color:var(--err)}
.tpl .tplact{display:flex;gap:8px;margin-top:10px;align-items:center;flex-wrap:wrap}
.tpl .fixed{color:var(--muted);font-size:14px}
.tablewrap.tall{max-height:78vh;overflow:auto}
.tablewrap.tall thead th{position:sticky;top:0;z-index:2;background:var(--paper)}
.tablewrap.tall thead th:first-child{z-index:3}
th.bd-h{text-align:left;color:var(--ink);font-weight:600;border-right:1px solid var(--rule);vertical-align:bottom}
.bd-sup{display:block;font-weight:400;font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis}
td.bd-wk{font-size:13px}
.bd-d{color:var(--muted);font-size:12px}
tr.bd-month td{border-top:1px solid var(--ink)}
td.bd{text-align:left;font-size:12px;padding:3px 7px;border-right:1px solid var(--rule);max-width:220px;overflow:hidden;text-overflow:ellipsis}
td.bd.fill{font-weight:600;border-bottom-color:rgba(255,255,255,.3)}
td.bd.con{border-bottom-color:transparent}
.tx{background:none!important;font-weight:600}
.tx.dp0{color:#4F7A5B} .tx.dp1{color:#7A58A6} .tx.dp2{color:#B0553A} .tx.dp3{color:#2F7F98} .tx.dp4{color:#3D5A73} .tx.dp5{color:#8C733A}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .tx.dp0{color:#8FC39C} :root:not([data-theme="light"]) .tx.dp1{color:#B79BDB} :root:not([data-theme="light"]) .tx.dp2{color:#E39A80} :root:not([data-theme="light"]) .tx.dp3{color:#7FC3D8} :root:not([data-theme="light"]) .tx.dp4{color:#9DB8D3} :root:not([data-theme="light"]) .tx.dp5{color:#D2B878} }
table.grid-fixed{table-layout:fixed;min-width:0}
table.grid-fixed th, table.grid-fixed td{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:none}
.tablewrap.z-s th.bd-h{font-size:12px;padding:6px 5px}
.tablewrap.z-s td.bd{font-size:11px;padding:2px 5px}
.tablewrap.z-l td.bd{font-size:13px}
.tablewrap.tall{cursor:grab}
.tablewrap.tall.dragging{cursor:grabbing;user-select:none}
.tablewrap{scrollbar-color:var(--muted) transparent}
.tablewrap::-webkit-scrollbar{width:12px;height:12px}
.tablewrap::-webkit-scrollbar-thumb{background:var(--muted);border-radius:6px;border:3px solid var(--paper)}
.tablewrap::-webkit-scrollbar-corner{background:var(--paper)}
#focusBtn{padding:7px 12px;font-weight:500}
body.focus .topbar, body.focus aside, body.focus #mainTitle, body.focus .summary, body.focus .note, body.focus .tpl{display:none!important}
body.focus .wrap{grid-template-columns:minmax(0,1fr);max-width:none}
body.focus main{padding:10px 14px 10px}
body.focus .tabs{margin-bottom:10px}
body.focus .tablewrap{margin-top:10px}
body.focus .tablewrap.tall{max-height:calc(100vh - 120px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px))}
th.bd-h{cursor:pointer}
th.bd-h:hover{background:var(--now)}
.stepdates{margin:4px 0 14px;padding:10px 12px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.stepdates .fixed{color:var(--muted);font-size:14px;margin:0}
.chk{display:flex;gap:8px;align-items:flex-start;color:var(--ink);font-size:14px;margin:0 0 6px}
.chk input{width:auto;margin-top:3px}
.steprow{display:grid;grid-template-columns:1fr auto;gap:2px 8px;padding:6px 0;border-top:1px solid var(--rule);align-items:baseline}
.steprow .nm{font-size:14px;font-weight:500}
.steprow .dt{font-size:12px;color:var(--muted);white-space:nowrap}
.steprow .ins{grid-column:1/-1;display:flex;gap:6px;align-items:center}
.steprow input[type=date]{padding:4px 6px;font-size:13px;min-width:0}
.steprow.adj .nm::after{content:" adjusted";font-size:12px;font-weight:600;color:#C9820A;margin-left:4px}
.steprow .rm{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:17px;padding:2px 4px}
.bar.tall{height:18px}
#auth{position:fixed;inset:0;z-index:60;background:var(--bg);display:flex;align-items:center;justify-content:center;padding:24px}
#auth[hidden]{display:none}
.authcard{width:min(400px,100%);background:var(--paper);border:1px solid var(--rule);border-radius:10px;padding:28px}
.authbrand{margin:0 0 4px;color:var(--muted);font-size:14px;font-weight:600}
#whoami{font-size:13px;color:var(--muted)}
body.ro #addJob, body.ro #peopleBox, body.ro #ctBox, body.ro #tplBox{display:none!important}
body.ro .sw{pointer-events:none;opacity:.6}
body.ro td[data-drag]{cursor:default}
td[data-drag]{cursor:ns-resize}
body.moving, body.moving *{cursor:ns-resize!important;user-select:none}
#dragTip{position:fixed;z-index:50;pointer-events:none;background:var(--ink);color:var(--bg);font-size:13px;font-weight:500;padding:5px 9px;border-radius:5px;white-space:nowrap}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:45;display:flex;gap:14px;align-items:center;background:var(--ink);color:var(--bg);padding:10px 14px;border-radius:8px;font-size:15px;max-width:calc(100vw - 32px)}
#toast button{background:transparent;border:1px solid var(--bg);color:var(--bg);border-radius:5px;padding:4px 10px;cursor:pointer;font-weight:600}
[hidden]#dragTip,[hidden]#toast{display:none}
#modalBack{display:none;position:fixed;inset:0;background:rgba(10,15,18,.45);z-index:34}
body.editing #modalBack{display:block}
#editor{position:fixed;z-index:35;top:50%;left:50%;transform:translate(-50%,-50%);width:min(900px,calc(100vw - 24px));max-height:calc(100vh - 32px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px));overflow:auto;background:var(--bg);border:1px solid var(--ink);border-radius:10px;margin:0;padding:0;box-shadow:0 20px 50px rgba(0,0,0,.3)}
#editor .mhead{position:sticky;top:0;z-index:2;background:var(--bg);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:16px 22px 12px;border-bottom:1px solid var(--rule)}
#editor .mhead h2{margin:0}
#editor .mhead .seg{width:auto}
#editor .msec{padding:18px 22px 4px}
#editor .cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 26px}
#editor .formerr{margin:0 22px 8px}
#editor .mfoot{position:sticky;bottom:0;background:var(--bg);display:flex;gap:8px;align-items:center;padding:12px 22px;border-top:1px solid var(--rule)}
#editor .mfoot .grow{flex:1}
#editor .mfoot .primary{flex:none;padding:9px 18px}
.stepdates:empty{display:none}
.mtable{overflow-x:auto;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.mtable table{min-width:760px}
.mtable th,.mtable td{text-align:left;padding:6px 8px;vertical-align:top}
.mtable th:first-child,.mtable td:first-child{position:static;border-right:0;max-width:none}
.mtable input,.mtable select{padding:4px 6px;font-size:14px}
.mtable input[type=number]{width:74px}
.mtable tr.warn td{background:color-mix(in srgb,var(--load3) 8%,transparent)}
.mtable tr.skip td{color:var(--muted)}
.mtable tr.skip td b{font-weight:500;text-decoration:line-through}
.sub2{display:block;font-size:12px;color:var(--muted)}
.flag{display:inline-block;margin:3px 4px 0 0;padding:1px 7px;border-radius:10px;font-size:12px;font-weight:600;color:#fff;background:var(--load3)}
tr.mrow{cursor:pointer}
tr.mrow:hover td{background:var(--now)}
tr.mrow td{text-align:left}
tr.sub.late td{color:var(--load3)}
table.mat th{text-align:left}
.cols2{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:0 14px;max-width:520px;margin-top:12px}
#ctEditor td{vertical-align:middle}
.pill{display:inline-block;margin:3px 4px 0 0;padding:1px 7px;border-radius:10px;font-size:12px;font-weight:600;background:var(--now);color:var(--ink)}
th.sortable{cursor:pointer;user-select:none;white-space:nowrap}
th.sortable:hover{color:var(--ink)}
th.sortable.on{color:var(--ink);font-weight:600}
th.sortable .arr{font-size:10px;margin-left:4px}
select.inl{width:auto;padding:3px 6px;font-size:14px;cursor:pointer}
.people-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;max-width:760px;margin-top:8px}
.person{padding:14px 12px;border:1px solid var(--rule);border-radius:8px;background:var(--paper);font-size:17px;font-weight:600;cursor:pointer;text-align:left}
.person:hover{border-color:var(--ink)}
.linkbtn{border:0;background:none;padding:0;color:var(--active);text-decoration:underline;cursor:pointer;font:inherit;font-size:15px;margin-left:6px}
.phl{font-size:11px;font-weight:500;opacity:.9}
#ctEditor .tpl table, #ctEditor table{min-width:0;margin-bottom:4px}
#ctEditor input[type=number]{width:80px}
#ctEditor select{width:auto}
@media (max-width:720px){ #editor .cols{grid-template-columns:1fr} }
.formerr{color:var(--err);font-size:14px;margin:0 0 10px}
[hidden]{display:none!important}
h1{font-family:var(--cond);font-weight:700;font-size:clamp(34px,5vw,52px);line-height:1;margin:0 0 10px}
.summary{font-size:19px;max-width:66ch;margin:0 0 22px}
.summary b{font-weight:600}
.mk{display:inline-block;width:.7em;height:.7em;border-radius:2px;margin-right:4px;vertical-align:.02em}
.mk.a{background:var(--active)} .mk.d{background:var(--design)}
.toolbar{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:10px;flex-wrap:wrap}
.legend{font-size:14px;color:var(--muted);display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.legend label{display:inline-flex;align-items:center;gap:6px;margin:0;font-size:14px;cursor:pointer}
.legend input{width:auto}
.chart{background:var(--paper);border:1px solid var(--rule);border-radius:6px;padding:8px 4px 4px;overflow-x:auto}
.chart svg{display:block;height:auto}
.chart text{font-family:var(--sans);font-size:12px;fill:var(--muted)}
.tablewrap{overflow-x:auto;margin-top:24px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
table{border-collapse:separate;border-spacing:0;font-variant-numeric:tabular-nums;font-size:14px;min-width:100%}
th,td{padding:7px 12px;white-space:nowrap;text-align:right;border-bottom:1px solid var(--rule)}
th{font-weight:500;color:var(--muted);border-bottom:1px solid var(--ink)}
th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:var(--paper);border-right:1px solid var(--rule);z-index:1;max-width:220px;overflow:hidden;text-overflow:ellipsis}
.now{background:var(--now)}
tr.sub td{font-weight:600}
tr.sub td:first-child .mk{margin-right:6px}
tr.grand td{font-weight:600;border-top:1px solid var(--ink);border-bottom:0}
td.tot,th.tot{border-left:1px solid var(--rule)}
td.job{padding-left:18px}
.zero{color:var(--rule)}
.note{font-size:14px;color:var(--muted);margin-top:10px}
@media (max-width:860px){
  .wrap{grid-template-columns:1fr}
  aside{border-right:0;border-bottom:1px solid var(--rule);padding:20px}
  main{padding:20px}
  .topbar{padding:14px 20px}
}
</style>
</head>
<body>
<div class="topbar"><strong>Billing forecast</strong><span>TR Design Build</span><span class="status" id="saveStatus">Loading jobs…</span><span id="whoami"></span><button type="button" class="linkbtn" id="signOut" hidden>Sign out</button></div>
<div id="auth" hidden>
  <div class="authcard">
    <p class="authbrand">TR Design Build</p>
    <h1 style="font-size:34px">Sign in</h1>
    <div id="authStep1">
      <p class="fixed" style="font-size:15px;margin:0 0 14px">Enter your work email and we'll send you a sign-in code.</p>
      <div class="field"><label for="authEmail">Email</label><input id="authEmail" type="email" autocomplete="email" placeholder="name@company.com"></div>
      <button type="button" class="primary" id="authSend" style="width:100%">Email me a code</button>
    </div>
    <div id="authStep2" hidden>
      <p class="fixed" style="font-size:15px;margin:0 0 14px">Check your email. Type the code here, or click the link in the email.</p>
      <div class="field"><label for="authCode">Code</label><input id="authCode" inputmode="numeric" autocomplete="one-time-code" placeholder="123456"></div>
      <button type="button" class="primary" id="authVerify" style="width:100%">Sign in</button>
      <button type="button" class="linkbtn" id="authBack" style="margin:12px 0 0">Use a different email</button>
    </div>
    <div id="authDenied" hidden>
      <p style="font-size:15px">You're signed in as <b id="authDeniedEmail"></b>, but that email isn't on the team list yet. Ask Todd to add it, then sign in again.</p>
      <button type="button" class="ghost" id="authDeniedOut">Sign out</button>
    </div>
    <p class="formerr" id="authErr" hidden></p>
  </div>
</div>
<div class="wrap">
  <aside>
    <h2>Jobs</h2>
    <button type="button" class="addbtn" id="addJob">Add a job</button>
    <div id="jobList"></div>

  </aside>

  <main>
    <div class="seg tabs" role="group" aria-label="View" id="tabSeg">
