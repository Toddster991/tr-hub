<script>
(function(){
  const $ = id => document.getElementById(id);
  const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const num = s => { const v = parseFloat(String(s ?? '').replace(/[^0-9.]/g,'')); return isFinite(v) ? v : NaN; };
  const parseDate = s => { if(!s || typeof s!=='string') return null; const [y,m,d] = s.split('-').map(Number); if(!y||!m||!d) return null; return new Date(y,m-1,d); };
  const iso = d => d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
  const addDays = (d,n) => new Date(d.getFullYear(), d.getMonth(), d.getDate()+n);
  const friday = d => addDays(d, (5 - d.getDay() + 7) % 7);
  const dayNum = d => Math.round(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())/864e5);
  const fromDayNum = n => { const u = new Date(n*864e5); return new Date(u.getUTCFullYear(), u.getUTCMonth(), u.getUTCDate()); };
  const fmtDate = d => d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
  const fmtShort = d => d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
  const money = v => { const c = Math.round(v*100)%100 !== 0; return v.toLocaleString('en-US',{style:'currency',currency:'USD',minimumFractionDigits:c?2:0,maximumFractionDigits:c?2:0}); };
  const money0 = v => Math.round(v).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0});
  const moneyK = v => v >= 1e6 ? '$'+(v/1e6).toLocaleString('en-US',{maximumFractionDigits:2})+'M' : v >= 1000 ? '$'+(v/1000).toLocaleString('en-US',{maximumFractionDigits:1})+'k' : '$'+Math.round(v);
  const monthsToWeeks = m => Math.max(1, Math.round(m*52/12));
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  const S = { msort:'order', mdir:1, owner:'all', matView:'urgency', matDate:'order', people:null, sec:'details', matEdit:{}, deptView:'Design', boardSort:'first', zoom:'m', sview:'job', template:null, tab:'home', me:(()=>{ try{ return localStorage.getItem('fc_me') || ''; }catch(e){ return ''; } })(), jobs:[], db:null, storage:'loading', sel:null, editStatus:'active', period:'week', showDesign:true, confirmDel:false };

  function split(total, n){
    const cents = Math.round(total*100), each = Math.floor(cents/n), out = [];
    for(let i=0;i<n;i++) out.push((i===n-1 ? cents-each*(n-1) : each)/100);
    return out;
  }

  // Active jobs: balance to bill = revised contract − invoiced; cost to complete = revised contract − value complete.
  // Jobs saved before these fields existed fall back to their stored balance.
  function activeCalc(j){
    const r = num(j.revised), inv = num(j.invoiced) || 0, val = num(j.valueComplete) || 0;
    if(r > 0) return { balance: Math.round((r-inv)*100)/100, ctc: Math.round((r-val)*100)/100, hasContract:true };
    return { balance: num(j.balance), ctc: num(j.ctc), hasContract:false };
  }

  // Weekly billing schedule for one job: [{date (a Friday), amt}]
  function schedule(j){
    let total, n, first;
    if(j.status === 'design'){
      total = num(j.price); const start = parseDate(j.start); const d = parseFloat(j.duration);
      if(!(total>0) || !start || !(d>0)) return null;
      n = j.durUnit === 'months' ? monthsToWeeks(d) : Math.max(1, Math.round(d));
      first = friday(start);
    } else {
      total = activeCalc(j).balance; const m = parseFloat(j.months); const asof = parseDate(j.asof);
      if(!(total>0) || !(m>0) || !asof) return null;
      n = monthsToWeeks(m);
      first = friday(addDays(asof,1));
    }
    const amts = split(total, n);
    const bills = amts.map((a,i)=>({date:addDays(first,7*i), amt:a}));
    return {bills, total, n, per:amts[0], first, last:bills[n-1].date};
  }

  // Period indexing
  const P = {
    week:   { idx:d=>dayNum(friday(d)), step:7, short:i=>fmtShort(fromDayNum(i)), long:i=>'Week ending '+fmtDate(fromDayNum(i)), head:i=>fmtShort(fromDayNum(i)), minSlot:18 },
    month:  { idx:d=>d.getFullYear()*12+d.getMonth(), step:1, short:i=>MON[i%12], long:i=>MON[i%12]+' '+Math.floor(i/12), head:i=>MON[i%12]+' '+String(Math.floor(i/12)).slice(2), minSlot:34 },
    quarter:{ idx:d=>d.getFullYear()*4+Math.floor(d.getMonth()/3), step:1, short:i=>'Q'+(i%4+1)+' '+String(Math.floor(i/4)).slice(2), long:i=>'Q'+(i%4+1)+' '+Math.floor(i/4), head:i=>'Q'+(i%4+1)+' '+Math.floor(i/4), minSlot:48 },
    year:   { idx:d=>d.getFullYear(), step:1, short:i=>String(i), long:i=>String(i), head:i=>String(i), minSlot:60 },
  };

  const isOff = j => j.status==='design' && j.included===false;

  function aggregate(){
    const p = P[S.period];
    const all = S.jobs.map(j=>({j, s:schedule(j)})).filter(x=>x.s && (S.showDesign || x.j.status!=='design'));
    const jobs = all.filter(x=>!isOff(x.j)), excluded = all.filter(x=>isOff(x.j));
    const cells = new Map(); // periodIdx -> {active, design, byJob: Map(id->amt)}
    let lo = Infinity, hi = -Infinity;
    jobs.forEach(({j,s})=>{
      s.bills.forEach(b=>{
        const k = p.idx(b.date); lo = Math.min(lo,k); hi = Math.max(hi,k);
        if(!cells.has(k)) cells.set(k,{active:0,design:0,byJob:new Map()});
        const c = cells.get(k);
        c[j.status==='design'?'design':'active'] += b.amt;
        c.byJob.set(j.id, (c.byJob.get(j.id)||0) + b.amt);
      });
    });
    const periods = [];
    if(isFinite(lo)) for(let k=lo;k<=hi;k+=p.step) periods.push(k);
    return {jobs, excluded, cells, periods, now:p.idx(new Date())};
  }

  // ---------- rendering ----------
  function renderList(){
    const groups = [['active','Active'],['design','In design']];
    let h = '';
    if(!S.jobs.length){
      h = `<p class="empty">${S.storage==='loading' ? 'Loading jobs…' : 'No jobs yet. Add one to start the forecast.'}</p>`;
    }
    groups.forEach(([st,label])=>{
      const list = S.jobs.filter(j=>(j.status==='design'?'design':'active')===st).sort((a,b)=>String(a.name).localeCompare(String(b.name)));
      if(!list.length) return;
      const sum = list.reduce((t,j)=>{ const s=schedule(j); return t+(s?s.total:0); },0);
      h += `<div class="group-h"><span><span class="mk ${st==='design'?'d':'a'}"></span>${label}</span><span>${money0(sum)}</span></div><ul class="joblist">`;
      list.forEach(j=>{
        const s = schedule(j);
        const meta = s ? `${money0(s.per)}/wk to ${fmtShort(s.last)} ${s.last.getFullYear()}${isOff(j)?' (off)':''}` : (j.status!=='design' && activeCalc(j).hasContract && activeCalc(j).balance<=0 ? 'Fully billed' : 'Missing details');
        h += `<li><button type="button" data-id="${esc(j.id)}" aria-current="${S.sel===j.id}"><span class="jn">${esc(j.name||'Untitled job')}</span><span class="jm">${meta}</span></button></li>`;
      });
      h += `</ul>`;
    });
    $('jobList').innerHTML = h;
    $('jobList').querySelectorAll('button[data-id]').forEach(b=>b.addEventListener('click',()=>openEditor(b.dataset.id)));
  }

  function renderSummary(ag){
    if(!ag.jobs.length){ $('summary').textContent = S.storage==='loading' ? '' : ag.excluded.length ? 'Every job is turned off. Switch one on in the table below to see the forecast.' : 'Add jobs on the left to build the forecast.'; return; }
    const wk = P.week, nowW = wk.idx(new Date());
    let tot=0, des=0;
    ag.jobs.forEach(({j,s})=>s.bills.forEach(b=>{ const k=wk.idx(b.date); if(k>=nowW && k<nowW+13*7){ tot+=b.amt; if(j.status==='design') des+=b.amt; }}));
    const allTot = ag.jobs.reduce((t,x)=>t+x.s.total,0);
    let t = `Over the next 13 weeks you're on track to bill <b>${money0(tot)}</b>, about <b>${money0(tot/13)}</b> a week.`;
    if(S.showDesign && des>0) t += ` <span class="mk d"></span><b>${money0(des)}</b> of that depends on jobs in design moving into production.`;
    t += ` ${ag.jobs.length} job${ag.jobs.length===1?'':'s'}, ${money0(allTot)} left to bill in total.`;
    if(ag.excluded.length) t += ` ${ag.excluded.length} job${ag.excluded.length===1?'':'s'} in design turned off.`;
    $('summary').innerHTML = t;
  }

  function niceCeil(v){
    if(v<=0) return 1;
    const p = Math.pow(10, Math.floor(Math.log10(v)));
    for(const m of [1,1.2,1.5,2,2.5,3,4,5,6,8,10]) if(m*p >= v) return m*p;
    return 10*p;
  }

  function renderChart(ag){
    const el = $('chart');
    if(!ag.periods.length){ el.innerHTML = ''; el.hidden = true; return; }
    el.hidden = false;
    const p = P[S.period], n = ag.periods.length;
    const L = 64, R = 16, T = 16, B = 34, H = 300;
    const W = Math.max(el.clientWidth - 8, L + R + n*p.minSlot);
    const iw = W-L-R, ih = H-T-B;
    const max = niceCeil(Math.max(...ag.periods.map(k=>{ const c=ag.cells.get(k); return c ? c.active+c.design : 0; })));
    const y = v => T + ih - (v/max)*ih;
    const slot = iw/n, bw = Math.max(4, Math.min(52, slot*0.7));
    const names = new Map(S.jobs.map(j=>[j.id, j.name||'Untitled job']));
    let s = `<svg width="${W}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Billing by ${S.period}, active and in-design jobs stacked">`;
    for(let i=0;i<=4;i++){
      const v = max*i/4, yy = y(v);
      s += `<line x1="${L}" x2="${W-R}" y1="${yy}" y2="${yy}" stroke="var(--rule)"/><text x="${L-8}" y="${yy+4}" text-anchor="end">${moneyK(v)}</text>`;
    }
    const step = Math.max(1, Math.ceil(n / (iw/60)));
    ag.periods.forEach((k,i)=>{
      const c = ag.cells.get(k), cx = L + slot*i + slot/2;
      if(k===ag.now) s += `<rect x="${L+slot*i}" y="${T}" width="${slot}" height="${ih}" fill="var(--now)"/>`;
      if(c){
        const tip = esc(p.long(k)+': '+money(Math.round((c.active+c.design)*100)/100) + [...c.byJob].map(([id,a])=>'\n  '+(names.get(id))+'  '+money(Math.round(a*100)/100)).join(''));
        const ya = y(c.active), yd = y(c.active+c.design);
        s += `<g><title>${tip}</title>`;
        if(c.active>0) s += `<rect x="${cx-bw/2}" y="${ya}" width="${bw}" height="${T+ih-ya}" fill="var(--active)"/>`;
        if(c.design>0) s += `<rect x="${cx-bw/2}" y="${yd}" width="${bw}" height="${ya-yd}" fill="var(--design)"/>`;
        s += `</g>`;
      }
      if(i % step === 0) s += `<text x="${cx}" y="${H-B+18}" text-anchor="middle">${esc(p.short(k))}</text>`;
    });
    s += `<line x1="${L}" x2="${W-R}" y1="${T+ih}" y2="${T+ih}" stroke="var(--ink)"/></svg>`;
    el.innerHTML = s;
  }

  function renderTable(ag){
    const tw = $('tableWrap');
    if(!ag.periods.length && !ag.excluded.length){ tw.hidden = true; return; }
    tw.hidden = false;
    const p = P[S.period];
    const cell = (v,k,cls='') => `<td class="${cls}${k===ag.now?' now':''}">${v>0.004 ? money0(v) : '<span class="zero">–</span>'}</td>`;
    let h = `<thead><tr><th>Job</th>${ag.periods.map(k=>`<th class="${k===ag.now?'now':''}" title="${esc(p.long(k))}">${esc(p.head(k))}</th>`).join('')}<th class="tot">Total</th></tr></thead><tbody>`;
    [['active','Active','a'],['design','In design','d']].forEach(([st,label,mk])=>{
      const byName = (a,b)=>String(a.j.name).localeCompare(String(b.j.name));
      const list = ag.jobs.filter(x=>(x.j.status==='design'?'design':'active')===st).sort(byName);
      const offList = st==='design' ? ag.excluded.slice().sort(byName) : [];
      if(!list.length && !offList.length) return;
      const sw = (j,on) => st==='design' ? `<button type="button" class="sw" role="switch" aria-checked="${on}" data-toggle="${esc(j.id)}" aria-label="Include ${esc(j.name||'job')} in the forecast"></button>` : '';
      const sub = ag.periods.map(k=>{ const c=ag.cells.get(k); return c ? c[st] : 0; });
      h += `<tr class="sub"><td><span class="mk ${mk}"></span>${label}</td>${sub.map((v,i)=>cell(v,ag.periods[i])).join('')}<td class="tot">${money0(sub.reduce((a,b)=>a+b,0))}</td></tr>`;
      list.forEach(({j,s})=>{
        h += `<tr><td class="job" title="${esc(j.name||'')}">${sw(j,true)}${esc(j.name||'Untitled job')}</td>${ag.periods.map(k=>{ const c=ag.cells.get(k); return cell(c ? (c.byJob.get(j.id)||0) : 0, k); }).join('')}<td class="tot">${money0(s.total)}</td></tr>`;
      });
      offList.forEach(({j,s})=>{
        h += `<tr class="off"><td class="job" title="${esc(j.name||'')} (turned off)">${sw(j,false)}${esc(j.name||'Untitled job')}</td>${ag.periods.map(k=>cell(0,k)).join('')}<td class="tot">${money0(s.total)}</td></tr>`;
      });
    });
    const grand = ag.periods.map(k=>{ const c=ag.cells.get(k); return c ? c.active+c.design : 0; });
    h += `</tbody><tfoot><tr class="grand"><td>Total billing</td>${grand.map((v,i)=>cell(v,ag.periods[i])).join('')}<td class="tot">${money0(grand.reduce((a,b)=>a+b,0))}</td></tr></tfoot>`;
    $('table').innerHTML = h;
    // scroll the current period into view once per period change
    const nowTh = $('table').querySelector('th.now');
    if(nowTh && S._scrolledFor !== S.tab+S.period){ S._scrolledFor = S.tab+S.period; tw.scrollLeft = Math.max(0, nowTh.offsetLeft - 240); }
  }

  // ---------- supervisors ----------
  const superKey = j => String(j.supervisor||'').trim();
  function supervisorNames(){
    const seen = new Map();
