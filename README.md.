    } else {
      const single = S.deptView && S.deptView!=='all' && depts.includes(S.deptView);
      if(single){
        const dSteps = deptSteps(S.deptView);
        $('legDept').innerHTML = dSteps.map(n=>`<span><span class="mk" style="background:${stepShade({name:n, dept:S.deptView})}"></span>${esc(n)}</span>`).join('');
      }
      (single ? [S.deptView] : depts).forEach(d=>{
        const rows = sd.jobs.map(x=>({j:x.j, parts:x.plan.filter(r=>r.dept===d)})).filter(x=>x.parts.length).sort((a,b)=>a.parts[0].s-b.parts[0].s);
        if(!rows.length) return;
        const lv = {};
        h += `<tr class="sub"><td><span class="mk ${deptClass(d)}"></span>${esc(d)} <span class="cnt">${rows.length} job${rows.length===1?'':'s'}</span></td>`;
        h += sd.periods.map(k=>{
          const on = rows.filter(x=>x.parts.some(r=>overlaps(r,k)));
