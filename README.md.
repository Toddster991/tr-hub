  function readCt(){
    const d = ctDraft(), t = d.ctypes.find(x=>x.id===d.sel), box = $('ctEditor');
    box.querySelectorAll('tr[data-ci]').forEach(tr=>{
      const c = d.catalog[+tr.dataset.ci], old = c.name;
      tr.querySelectorAll('[data-cf]').forEach(inp=>{ const f = inp.dataset.cf; c[f] = f==='name' ? inp.value.trim() : (f==='owner'||f==='kind') ? inp.value : (parseFloat(inp.value)||0); });
      if(old!==c.name) d.ctypes.forEach(x=>{ if(x.items[old]!==undefined){ x.items[c.name] = x.items[old]; delete x.items[old]; } });
    });
    const b = box.querySelector('[data-cb]'); if(b) d.buffer = Math.max(0, parseFloat(b.value)||0);
    if(t){
      const tn = box.querySelector('[data-tn]'); if(tn) t.name = tn.value.trim() || t.name;
      const tm = box.querySelector('[data-tm]'); if(tm) t.months = parseFloat(tm.value) || t.months;
      box.querySelectorAll('tr[data-pi]').forEach(tr=>{
        const x = t.phases[+tr.dataset.pi], old = x.name;
        tr.querySelectorAll('[data-pf]').forEach(inp=>{ const f = inp.dataset.pf; x[f] = f==='name' ? inp.value.trim() : Math.min(100, Math.max(0, parseFloat(inp.value)||0)); });
        if(old!==x.name) Object.keys(t.items).forEach(k=>{ if(t.items[k]===old) t.items[k] = x.name; });
      });
      box.querySelectorAll('[data-im]').forEach(sel=>{ if(sel.value) t.items[sel.dataset.im] = sel.value; else delete t.items[sel.dataset.im]; });
    }
  }
