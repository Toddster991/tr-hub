  // ---------- drag a board cell up or down to move it by whole weeks ----------
  // Construction moves the production start; a design step moves that step and every step before it.
  function cascadeDates(j, name, deltaDays, resize=false){
    const auto = (jobPlan({...j, stepDates:null}, false) || []).filter(r=>r.dept!==PROD);
    const idx = auto.findIndex(r=>r.name===name); if(idx<0) return j.stepDates || {};
    const cur0 = j.stepDates && typeof j.stepDates==='object' ? j.stepDates : {};
    const out = JSON.parse(JSON.stringify(cur0));
    const cur = n => { const o = cur0[n], r = auto.find(x=>x.name===n);
      return (o && parseDate(o.start) && parseDate(o.end)) ? {s:dayNum(parseDate(o.start)), e:dayNum(parseDate(o.end))} : {s:r.s, e:r.e-1}; };
    if(resize){
      // move only the step's start edge (its end stays put); earlier steps shift with it to stay linked
      const me = cur(name), eff = Math.min(deltaDays, me.e - me.s);
      for(let i=0;i<idx;i++){ const c = cur(auto[i].name); out[auto[i].name] = {start:iso(fromDayNum(c.s+eff)), end:iso(fromDayNum(c.e+eff))}; }
      out[name] = {start:iso(fromDayNum(me.s+eff)), end:iso(fromDayNum(me.e))};
    } else {
      for(let i=0;i<=idx;i++){ const c = cur(auto[i].name); out[auto[i].name] = {start:iso(fromDayNum(c.s+deltaDays)), end:iso(fromDayNum(c.e+deltaDays))}; }
    }
    // keep only steps that differ from their automatic dates
    Object.keys(out).forEach(n=>{ const a = auto.find(r=>r.name===n); if(a && out[n].start===iso(fromDayNum(a.s)) && out[n].end===iso(fromDayNum(a.e-1))) delete out[n]; });
    return out;
  }
  const constWeeks = j => j.durUnit==='months' ? monthsToWeeks(parseFloat(j.duration)) : Math.max(1, Math.round(parseFloat(j.duration)));
  function movedJob(j, step, weeks, mode='move'){
    if(mode==='resize'){
      if(step==='Construction') return {...j, duration: Math.max(1, constWeeks(j)+weeks), durUnit:'weeks'};
      return {...j, stepDates: cascadeDates(j, step, 7*weeks, true)};
    }
    if(step==='Construction') return {...j, start: iso(addDays(parseDate(j.start), 7*weeks))};
    return {...j, stepDates: cascadeDates(j, step, 7*weeks)};
  }
  function dragTipText(d){
    const pj = d.preview || d.orig, plan = jobPlan(pj) || [];
    const r = plan.find(x=>x.name===d.step);
    if(d.mode==='resize' && r){
      const days = r.e - r.s, len = days % 7 === 0 ? `${days/7} week${days===7?'':'s'}` : `${days} day${days===1?'':'s'}`;
      const r0 = (jobPlan(d.orig)||[]).find(x=>x.name===d.step), d0 = r0 ? r0.e - r0.s : days;
      const was = days!==d0 ? ` (was ${d0%7===0 ? d0/7+' wk' : d0+' days'})` : '';
      return `${d.step}: ${len}${was}`;
    }
    const when = r ? fmtDate(fromDayNum(r.s)) : '';
    const w = d.delta ? ` (${d.delta>0?'+':'−'}${Math.abs(d.delta)} wk)` : '';
    return `${d.step==='Construction'?'Construction':d.step} starts ${when}${w}`;
  }
  $('tableWrap').addEventListener('mousedown', e=>{
