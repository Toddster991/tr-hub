    const name = row.dataset.step;
    const auto = (jobPlan({...formJob(), stepDates:null}, false) || []).filter(r=>r.dept!==PROD);
    const idx = auto.findIndex(r=>r.name===name); if(idx<0) return;
    // current dates for a step (end inclusive): its override if it has one, otherwise automatic
    const cur = n => { const o = S.stepEdit.dates[n], r = auto.find(x=>x.name===n);
      return (o && parseDate(o.start) && parseDate(o.end)) ? {s:dayNum(parseDate(o.start)), e:dayNum(parseDate(o.end))} : {s:r.s, e:r.e-1}; };
