  async function saveJob(e){
    e.preventDefault();
    if(!isAdmin()){
      // Ordering level: only the job's materials are saved
      if(S.sel==='new') return closeEditor();
      F('save').disabled = true;
      try{ await S.db.collection('jobs').doc(S.sel).update({materials: cleanMats(S.matEdit)}); closeEditor(); }
      catch(err){ showErr(err && err.code==='invalid_argument' ? "Your access level can change materials only." : "Couldn't save. Try again."); }
      finally{ F('save').disabled = false; }
      return;
    }
    const fj = formJob();
    if(!fj.name) return showErr('Give the job a name.');
    if(fj.status==='design' && !schedule(fj)) return showErr('Enter a sell price, production start and duration.');
    if(fj.status!=='design'){
      if(!(fj.revised>0) || !(fj.months>0) || !parseDate(fj.asof)) return showErr('Enter the revised contract, months remaining and the as-of date.');
      if(activeCalc(fj).balance < 0) return showErr('Amount invoiced is more than the revised contract.');
    }
    const body = { name:fj.name, status:fj.status, updatedAt:new Date().toISOString() };
    if(fj.ctype) body.ctype = fj.ctype;
    if(fj.status!=='design' && parseDate(fj.conStart)) body.conStart = fj.conStart;
    const mats = {};
    Object.entries(S.matEdit||{}).forEach(([k,v])=>{ if(!v) return; const c = {};
      if(STATUS[v.status] && v.status!=='none') c.status = v.status;
      if(parseFloat(v.lead)>0) c.lead = parseFloat(v.lead);
      if(parseDate(v.ordered)) c.ordered = v.ordered; if(parseDate(v.promised)) c.promised = v.promised;
      if(v.owner) c.owner = v.owner;
      if(Object.keys(c).length) mats[k] = c; });
    if(Object.keys(mats).length) body.materials = mats;
    if(fj.supervisor) body.supervisor = fj.supervisor;
    if(fj.status==='design'){
      Object.assign(body,{price:fj.price,start:fj.start,duration:fj.duration,durUnit:fj.durUnit});
      if(S.stepEdit && !S.stepEdit.auto){
        const auto = jobPlan({...fj, stepDates:null}, false) || [];
        const keep = {};
        Object.entries(S.stepEdit.dates).forEach(([n,o])=>{
          const a = auto.find(r=>r.name===n); if(!a || !parseDate(o.start) || !parseDate(o.end)) return;
          if(parseDate(o.end) < parseDate(o.start)) return;
          if(o.start !== iso(fromDayNum(a.s)) || o.end !== iso(fromDayNum(a.e-1))) keep[n] = {start:o.start, end:o.end};
