    }
    h += `</tbody>`;
    $('table').innerHTML = h;
    const nowTh = $('table').querySelector('th.now'), key = S.tab+S.sview+S.period;
    if(nowTh && S._scrolledFor !== key){ S._scrolledFor = key; tw.scrollLeft = Math.max(0, nowTh.offsetLeft - 240); }
  }

  // Board: jobs across the top, weeks running down, like the spreadsheet schedule
  // Supervisor accent colors (kept away from the production blue)
  const SUP_COLORS = ['#E8833A','#C0392B','#E0B400','#8E44AD','#27AE60','#E84393','#16A085','#6D4C41','#D35400','#2C3E50'];
  const PROD_FILL = '#2F6FC9';
  const DEPT_TINTS = ['#3E9B4F','#8352C4','#8B5E3C','#1597AE','#C0417A','#6B7B8C'];
  // Design phases each get a distinct color, in step order
  const DESIGN_COLORS = ['#F2C230','#F08A24','#D9372B','#2BA3D9','#3E9B4F','#8352C4'];
  const inkFor = hex => { const [r,g,b] = [1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)/255); return (0.299*r+0.587*g+0.114*b) > 0.6 ? '#1E272D' : '#FFFFFF'; };
  const mix = (a,b,t) => { const pa=[1,3,5].map(i=>parseInt(a.slice(i,i+2),16)), pb=[1,3,5].map(i=>parseInt(b.slice(i,i+2),16)); return '#'+pa.map((v,i)=>Math.round(v+(pb[i]-v)*t).toString(16).padStart(2,'0')).join(''); };
  // Design steps get their own shade of green, light to dark in step order; every other department one tint
  function stepFill(r){
    if(r.dept===PROD) return PROD_FILL;
    if(r.dept.toLowerCase()==='design'){
      const ds = steps().filter(st=>(st.dept||'').trim().toLowerCase()==='design').map(st=>st.name);
      const i = Math.max(0, ds.indexOf(r.name)), n = ds.length;
      return DESIGN_COLORS[i % DESIGN_COLORS.length];
    }
    return DEPT_TINTS[deptOrder().indexOf(r.dept) % DEPT_TINTS.length];
  }
  // Short labels so every board column can stay the same width
  const SHORT = {'wood exterior doors':'Ext doors', 'design kickoff & field measure':'Kickoff/measure','conceptual design':'Conceptual','schematic design':'Schematic','design development':'Design dev','contract presentation':'Presentation','client review':'Client review','contract revisions':'Revisions','signed contract':'Signed','pre-production':'Pre-prod','pre production':'Pre-prod','permitting':'Permit','estimating':'Estimating','construction':'Construction'};
  const shortName = n => SHORT[String(n).toLowerCase()] || n;
  // Steps within one department, in template order, and a shade for each (light to dark)
  const deptSteps = d => steps().filter(st=>((st.dept||'Other').trim()||'Other')===d).map(st=>st.name);
  function stepShade(r){
    if(r.dept===PROD) return PROD_FILL;
    if(r.dept.toLowerCase()==='design'){
      // distinct colors for design phases in the single-department view: yellow, orange, red, blue, then extras
      const DESIGN_PHASES = ['#F2C230','#F08A24','#D63B2F','#2F6FC9','#3E9B4F','#8352C4'];
      const ds = deptSteps(r.dept), i = Math.max(0, ds.indexOf(r.name));
      return DESIGN_PHASES[i % DESIGN_PHASES.length];
    }
    const base = DEPT_TINTS[deptOrder().indexOf(r.dept) % DEPT_TINTS.length];
    const ds = deptSteps(r.dept), n = ds.length, i = Math.max(0, ds.indexOf(r.name));
    return n>1 ? mix(mix(base,'#FFFFFF',0.45), mix(base,'#000000',0.3), i/(n-1)) : base;
  }
  function renderBoard(sd){
    const tw = $('tableWrap'), names = supervisorNames().map(n=>n.toLowerCase());
    const supColor = j => { const i = names.indexOf(superKey(j).toLowerCase()); return i<0 ? null : SUP_COLORS[i % SUP_COLORS.length]; };
    // legend: departments (design shown as its run of greens) and supervisor accents
    const depts = deptOrder();
    const designSteps = steps().filter(st=>(st.dept||'').trim().toLowerCase()==='design');
    let leg = depts.map(d=>{
      if(d.toLowerCase()==='design' && designSteps.length){
        const g = designSteps.map(st=>stepFill({name:st.name, dept:st.dept.trim()}));
        return `<span><span class="mk" style="width:2.2em;background:linear-gradient(90deg,${g.join(',')})"></span>${esc(d)}</span>`;
      }
      return `<span><span class="mk" style="background:${d===PROD?PROD_FILL:DEPT_TINTS[depts.indexOf(d)%DEPT_TINTS.length]}"></span>${esc(d)}</span>`;
    }).join('');
    leg += supervisorNames().map(n=>`<span><span class="mk" style="width:.35em;border-radius:0;background:${SUP_COLORS[names.indexOf(n.toLowerCase())%SUP_COLORS.length]}"></span>${esc(n)}</span>`).join('');
    $('legDept').innerHTML = leg;

    // column order: by the start of the chosen department (jobs without it go last), else by first step
    const opts = [['first','First step']].concat(deptOrder().map(d=>[d, d+' start']));
    if(!opts.some(o=>o[0]===S.boardSort)) S.boardSort = 'first';
    $('boardSort').innerHTML = opts.map(([v,l])=>`<option value="${esc(v)}"${v===S.boardSort?' selected':''}>${esc(l)}</option>`).join('');
    const sortKey = x => {
      if(S.boardSort==='first') return x.plan[0].s;
      const parts = x.plan.filter(r=>r.dept===S.boardSort);
      return parts.length ? Math.min(...parts.map(r=>r.s)) : Infinity;
    };
    const frozen = S.drag && S.drag.order;  // keep columns still while dragging
    const jobs = sd.jobs.slice().sort((a,b)=> frozen ? frozen.indexOf(a.j.id)-frozen.indexOf(b.j.id) : (()=>{ const ka=sortKey(a), kb=sortKey(b); return ka===kb ? a.plan[0].s-b.plan[0].s : ka-kb; })());
    const colW = {s:90, m:125, l:180}[S.zoom] || 125, wkW = 104;
    let h = `<thead><tr><th class="bd-wk" style="width:${wkW}px">Week</th>${jobs.map(({j})=>{ const c = supColor(j);
      return `<th class="bd-h" data-job="${esc(j.id)}" title="${esc((j.name||'')+(superKey(j)?' ('+superKey(j)+')':'')+' (double-click to edit)')}" style="width:${colW}px${c?`;border-top:4px solid ${c}`:''}">${esc(j.name||'Untitled job')}${superKey(j)?`<span class="bd-sup">${esc(superKey(j))}</span>`:''}</th>`; }).join('')}</tr></thead><tbody>`;
    let lastMonth = -1;
    sd.periods.forEach(k=>{
      const fri = fromDayNum(k), newMonth = fri.getMonth()!==lastMonth;
      lastMonth = fri.getMonth();
      const nowc = k===sd.now ? ' now' : '';
      h += `<tr class="${newMonth?'bd-month':''}"><td class="bd-wk${nowc}">${newMonth?`<b>${MON[fri.getMonth()]} '${String(fri.getFullYear()).slice(2)}</b> `:''}<span class="bd-d">${fmtShort(fri)}</span></td>`;
      jobs.forEach(({j,plan})=>{
        const hit = plan.filter(r=>overlaps(r,k,'week'));
        const con = hit.find(r=>r.dept===PROD);
        if(con){
          const firstWk = P.week.idx(fromDayNum(con.s)), secondWk = firstWk + 7, c = supColor(j);
          const phStart = phasesFor(j).filter(x=>P.week.idx(fromDayNum(x.s))===k).map(x=>shortName(x.name));
          const label = k===firstWk ? `<b>${esc(superKey(j)||'No supervisor')}</b>` : k===secondWk ? `Const start ${fromDayNum(con.s).toLocaleDateString('en-US',{month:'numeric',day:'numeric',year:'2-digit'})}` : phStart.length ? `<span class="phl">${esc(phStart.join(' / '))}</span>` : '';
          const accent = c ? `border-left:6px solid ${c};` : 'border-left:6px dashed #9AA5AB;';
          const dc = j.status==='design' ? ` data-job="${esc(j.id)}" data-drag="Construction"` : '';
          h += `<td class="bd fill con"${dc} style="background:${PROD_FILL};color:${inkFor(PROD_FILL)};${accent}" title="${esc((j.name||'')+': construction '+rangeTxt(con.s,con.e)+(superKey(j)?' ('+superKey(j)+')':''))}">${label}</td>`;
        } else if(hit.length){
          const fills = hit.map(stepFill);
          const bg = fills.length===1 ? fills[0] : `linear-gradient(90deg,${fills.map((f,i)=>`${f} ${i/fills.length*100}%,${f} ${(i+1)/fills.length*100}%`).join(',')})`;
          const ds = j.status==='design' ? ` data-job="${esc(j.id)}" data-drag="${esc(hit[hit.length-1].name)}"` : '';
          h += `<td class="bd fill"${ds} style="background:${bg};color:${inkFor(fills[0])}" title="${esc(hit.map(r=>r.name+' ('+r.dept+'): '+rangeTxt(r.s,r.e)).join('\n'))}">${hit.map(r=>esc(shortName(r.name))).join(' / ')}</td>`;
        } else h += `<td class="bd${nowc}"></td>`;
      });
      h += `</tr>`;
    });
    h += `</tbody>`;
    $('table').innerHTML = h;
    $('table').classList.add('grid-fixed');
    $('table').style.width = (wkW + colW*jobs.length) + 'px';
    const nowTd = $('table').querySelector('td.bd-wk.now'), key = S.tab+'board';
    if(nowTd && S._scrolledFor !== key){ S._scrolledFor = key; tw.scrollTop = Math.max(0, nowTd.parentElement.offsetTop - 80); }
  }

  // ---------- standard steps editor ----------
  function renderTplEditor(){
    const rows = (S.tplDraft || steps()).map(x=>({...x}));
    S.tplDraft = rows;
    const depts = deptOrder();
    let h = `<div class="inner"><datalist id="deptList">${depts.map(d=>`<option value="${esc(d)}"></option>`).join('')}</datalist><table><thead><tr><th>Step</th><th>Department</th><th>Duration</th><th></th><th>Alongside previous</th><th></th></tr></thead><tbody>`;
    rows.forEach((r,i)=>{
      h += `<tr data-i="${i}"><td><input data-f="name" value="${esc(r.name||'')}" aria-label="Step name"></td>
        <td><input data-f="dept" list="deptList" value="${esc(r.dept||'')}" aria-label="Department"></td>
        <td><input data-f="dur" type="number" min="1" step="1" value="${esc(r.dur||1)}" aria-label="Duration"></td>
        <td><select data-f="unit" aria-label="Unit"><option value="days"${r.unit==='days'?' selected':''}>days</option><option value="weeks"${r.unit!=='days'?' selected':''}>weeks</option></select></td>
        <td><input data-f="withPrev" type="checkbox"${r.withPrev?' checked':''}${i===0?' disabled':''} aria-label="Runs alongside previous step"></td>
        <td><button type="button" class="rm" data-rm="${i}" aria-label="Remove ${esc(r.name||'step')}">×</button></td></tr>`;
    });
    h += `<tr><td colspan="6" class="fixed">Construction (Production) follows automatically, using each job's own duration.</td></tr></tbody></table>
      <div class="tplact"><button type="button" class="ghost" id="tplAdd">Add a step</button><button type="button" class="primary" id="tplSave" style="flex:none">Save steps</button><button type="button" class="ghost" id="tplReset">Undo changes</button><span class="fixed" id="tplMsg"></span></div></div>`;
    $('tplEditor').innerHTML = h;
  }
  function readTpl(){
    $('tplEditor').querySelectorAll('tr[data-i]').forEach(tr=>{
      const r = S.tplDraft[+tr.dataset.i];
      tr.querySelectorAll('[data-f]').forEach(inp=>{
        const f = inp.dataset.f;
        r[f] = f==='withPrev' ? inp.checked : f==='dur' ? (parseFloat(inp.value)||1) : inp.value.trim();
      });
    });
  }
  $('tplEditor').addEventListener('input', ()=>{ S.tplDirty = true; readTpl(); $('tplMsg').textContent = 'Unsaved changes'; });
  $('tplEditor').addEventListener('click', async e=>{
    const rm = e.target.closest('[data-rm]');
    if(rm){ readTpl(); S.tplDraft.splice(+rm.dataset.rm,1); if(S.tplDraft[0]) S.tplDraft[0].withPrev=false; S.tplDirty = true; renderTplEditor(); $('tplMsg').textContent='Unsaved changes'; return; }
    if(e.target.id==='tplAdd'){ readTpl(); S.tplDraft.push({name:'New step', dept:'', dur:1, unit:'weeks'}); S.tplDirty = true; renderTplEditor(); $('tplMsg').textContent='Unsaved changes'; return; }
    if(e.target.id==='tplReset'){ S.tplDraft = null; S.tplDirty = false; renderTplEditor(); return; }
    if(e.target.id==='tplSave'){
      readTpl();
      const clean = S.tplDraft.filter(r=>r.name).map((r,i)=>({name:r.name, dept:r.dept||'Other', dur:Math.max(1,r.dur||1), unit:r.unit==='days'?'days':'weeks', withPrev: i>0 && !!r.withPrev}));
      if(!clean.length){ $('tplMsg').textContent = 'Keep at least one step.'; return; }
      try{
        if(S.db) await S.db.doc('settings/schedule').set({steps:clean});
        S.template = clean; S.tplDraft = null; S.tplDirty = false; renderTplEditor(); render();
